# ============================================================================
# EPOREX — deny ALL direct web access to this folder.
# The PHP pages on the server can still `require` these files; a browser
# requesting /config/smtp.php gets 403 Forbidden.
# ============================================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 and older
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
